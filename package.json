{
  "name": "txt-sheets",
  "productName": "TXT Sheets",
  "version": "0.2.1",
  "description": "A beautiful, minimal, local-first spreadsheet application for Windows.",
  "main": "dist/main/main.cjs",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kichong/TXT-sheets.git"
  },
  "homepage": "https://github.com/kichong/TXT-sheets",
  "scripts": {
    "start": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:main\" \"pnpm dev:preload\" \"pnpm dev:electron\"",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:main": "vite build --watch --config vite.main.config.ts",
    "dev:preload": "vite build --watch --config vite.preload.config.ts",
    "dev:electron": "wait-on tcp:5173 dist/main/main.cjs dist/preload/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "pnpm clean && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('release',{recursive:true,force:true})\"",
    "icons": "node scripts/create-icons.mjs",
    "make": "pnpm build && electron-builder --publish never",
    "release:github": "pnpm build && electron-builder --win nsis --x64 --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "author": "TXT Sheets",
  "license": "Apache-2.0",
  "build": {
    "appId": "com.txtsheets.app",
    "productName": "TXT Sheets",
    "asar": true,
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [{ "provider": "github", "owner": "kichong", "repo": "TXT-sheets", "releaseType": "draft" }],
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [{ "from": "build/icon.ico", "to": "icon.ico" }],
    "fileAssociations": [
      { "ext": "xlsx", "name": "Excel workbook", "role": "Editor" },
      { "ext": "csv", "name": "Comma-separated values", "role": "Editor" },
      { "ext": "tsv", "name": "Tab-separated values", "role": "Editor" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"],
      "artifactName": "TXT-Sheets-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.18",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^2.1.8",
    "playwright": "^1.58.2",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
